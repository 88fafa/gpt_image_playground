#!/bin/sh

# 兼容旧版本 Docker 环境变量：API_URL 同时作为两个新变量的兜底值。
DOCKER_LEGACY_API_URL_USED=false
if [ -n "$API_URL" ]; then
    DOCKER_LEGACY_API_URL_USED=true
fi

if [ "${DEFAULT_API_URL+x}" != "x" ]; then
    DEFAULT_API_URL=${API_URL:-https://api.openai.com/v1}
fi
API_PROXY_URL=${API_PROXY_URL:-${API_URL:-https://api.openai.com/v1}}

if [ "$ENABLE_ASYNC_IMAGE_API" = "true" ]; then
    ASYNC_IMAGE_API_PORT=${ASYNC_IMAGE_API_PORT:-8787}
    UPSTREAM_RESPONSES_BASE_URL=${UPSTREAM_RESPONSES_BASE_URL:-$API_PROXY_URL}
fi

export DEFAULT_API_URL
export API_PROXY_URL
export ASYNC_IMAGE_API_PORT
export UPSTREAM_RESPONSES_BASE_URL
export DOCKER_LEGACY_API_URL_USED
